<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AutoCAD 2024 (R24.3) hosts .NET Framework 4.8, so this plugin cannot reuse the
    net8.0 assembly built for AutoCAD 2026. The C# sources are shared with
    Himec.AutoCad2026 by linking rather than copying; only the target framework,
    the Autodesk reference assemblies and the output name differ.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Himec.AutoCad2024</AssemblyName>
    <RootNamespace>Himec.AutoCad2026</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AutoCadDir Condition="'$(AutoCadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2024\</AutoCadDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- net8.0 adds this to the implicit using set; .NET Framework does not. -->
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared plugin sources. Linked, not duplicated. -->
    <Compile Include="..\Himec.AutoCad2026\*.cs" LinkBase="Shared" />
    <!-- `init` accessors need this marker type on .NET Framework. -->
    <Compile Include="..\Himec.ChangeCore\Net48Polyfills.cs" Link="Net48Polyfills.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Himec.ChangeCore/Himec.ChangeCore.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is referenced explicitly; UseWindowsForms only applies to net5.0+. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AcMgd"><HintPath>$(AutoCadDir)AcMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCadDir)AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCadDir)AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
